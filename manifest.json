{
  "manifest_version": 3,
  "name": "Авито Проверка Оригинала",
  "version": "1.2",
  "description": "Проверяет товары на оригинальность с помощью Google Gemini",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.avito.st/*",
    "https://*.avito.ru/*",
    "https://*.yandex.net/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.avito.ru/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}